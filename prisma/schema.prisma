generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())

  sessions  Session[]
  episodes  Episode[]
  /// The platform connections this user has authorised. A relation field only —
  /// it adds no column to `User`, so existing rows are untouched.
  platformAccounts PlatformAccount[]
  oauthStates      OAuthState[]
}

/// A one-time email code. Only the hash is stored, so a database leak cannot be
/// replayed into a login. Rows are deleted once used or expired.
model LoginCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}

/// One user's authorised connection to one platform. Today the only `provider`
/// is `youtube`.
///
/// WHAT IS IN HERE IS A LONG-LIVED CREDENTIAL, so none of it is stored in the
/// clear. `refreshTokenEnc` and `accessTokenEnc` hold AES-256-GCM ciphertext
/// produced by `src/lib/publish/youtube/secrets.ts` from a key that lives only
/// in `BOOKREEL_TOKEN_KEY` — never in this file, never in the database, never
/// in a response body. The additional-authenticated-data is the user id and the
/// purpose, so a row copied into another user's record fails to decrypt rather
/// than silently granting access to someone else's channel.
///
/// There is deliberately NO plaintext column for either token and no column
/// that could be mistaken for one. `scope` is recorded because a connection
/// authorised before a scope was added cannot do the new thing, and the honest
/// answer to that is "reconnect", which needs the old grant to be legible.
///
/// BACKWARD COMPATIBILITY. A new table with no rows. Absent means "no platform
/// is connected", which is the truth for every existing install.
model PlatformAccount {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// `youtube`. A free string for the same reason `PublishJob.platform` is one.
  provider String

  /// AES-256-GCM, keyed from the environment. See the note above.
  refreshTokenEnc String
  /// The short-lived access token, cached so a publish does not refresh on every
  /// call. Encrypted the same way, and treated as disposable: a decrypt failure
  /// or an expiry simply means "refresh".
  accessTokenEnc  String?
  accessExpiresAt DateTime?

  /// The scopes Google actually granted, space-separated, as returned by the
  /// token endpoint rather than as requested.
  scope String

  /// What the platform told us about the account, after the first call that
  /// returned it. Null until then — never guessed.
  externalAccountId String?
  externalAccountName String?

  /// Set when Google (or a Disconnect) has invalidated the grant. The row is
  /// normally deleted on disconnect; this exists for the case where the revoke
  /// call itself failed and the credential must still stop being used.
  revokedAt DateTime?

  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId])
}

/// One in-flight OAuth authorisation. Exists so `state` is validated against a
/// value this server stored rather than against a cookie the caller controls,
/// and so the PKCE code verifier never leaves the server.
///
/// `stateHash` rather than `state`, for the same reason `Session` stores
/// `tokenHash`: the state travels through a browser URL and a Google redirect,
/// and a database leak must not hand anyone a replayable value. The verifier is
/// encrypted with the same key as the tokens.
///
/// Rows are single-use (deleted when redeemed) and expire; `expiresAt` is what
/// makes an abandoned authorisation stop being redeemable.
model OAuthState {
  id        String   @id @default(cuid())
  stateHash String   @unique
  provider  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// AES-256-GCM of the PKCE code verifier.
  verifierEnc String
  /// Where in the app to send the operator back to. App-relative only —
  /// validated before it is stored and again before it is used.
  returnTo  String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// A book the operator photographs, returned to over many uploads.
model Book {
  id             String  @id @default(cuid())
  title          String
  openLibraryId  String?
  coverPath      String?
  year           Int?
  subjects       String? // JSON string[]
  /// story | motivation | philosophy | howto | memoir
  archetype      String  @default("motivation")
  /// public-domain | in-copyright | own-work — drives the quotation budget.
  rightsStatus   String  @default("in-copyright")

  /// Where to buy this book, typed by the operator at upload. Optional and
  /// nullable, so no existing row is invalidated and nothing needs a
  /// backfill. Only an http(s) URL is ever stored — anything else is written
  /// as null rather than refused, because a mistyped link must not cost the
  /// operator the whole upload. Present: the description ends with it and the
  /// video ends on a purchase card. Absent: neither appears at all.
  bookLink       String?

  /// Null unless every link of the verification chain held. Never a
  /// placeholder: an unverified author is ABSENT, not "unknown".
  author               String?
  authorVerified       Boolean @default(false)
  /// Which link broke, so the omission is explainable rather than mysterious.
  authorOmissionReason String?

  uploads   Upload[]
  episodes  Episode[]
  usedHooks UsedHook[]
  usedIdeas UsedIdea[]
  ideas     ContentIdea[]
  createdAt DateTime @default(now())
}

/// One batch of photographs, or one book PDF.
model Upload {
  id        String  @id @default(cuid())
  bookId    String
  book      Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId    String?
  /// photos | pdf. A photo batch goes through `runIngest`; a PDF goes through
  /// `runBookAnalysis` and ends in `ContentIdea` rows rather than episodes.
  kind      String  @default("photos")
  status    String  @default("QUEUED")
  step      String  @default("Queued")
  error     String?
  /// The uploaded PDF, under WORK_ROOT. Null for a photo batch.
  sourcePath String?
  pageCount  Int?
  /// JSON {label, done, total} — the finer-grained position inside `step`
  /// ("Page 37 of 200"), so a long step never looks frozen.
  progress   String?
  /// JSON string[] of advisory findings, the same role `Episode.notes` plays.
  notes      String?
  /// JSON AnalysisStats — how many candidates were found, dropped and why.
  stats      String?
  pages     Page[]
  episodes  Episode[]
  sections  Section[]
  chunks    Chunk[]
  ideas     ContentIdea[]
  createdAt DateTime @default(now())
  /// Bumped by every `prisma.upload.update` in `runIngest` (once per step
  /// transition). `reap.ts` uses this — not `createdAt` — to tell "stuck on
  /// the current step" apart from "a long-running upload that is still
  /// making progress": `Upload` has no per-step `StepRun` history the way
  /// `Episode` does, so this is the only signal a reaper has.
  updatedAt DateTime @default(now()) @updatedAt

  @@index([bookId])
}

/// One photograph of one page.
model Page {
  id          String  @id @default(cuid())
  uploadId    String
  upload      Upload  @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  /// Reading order. This is what the operator reorders before ingest starts.
  pageIndex   Int
  filePath    String  // EXIF-stripped original, under WORK_ROOT
  derivedPath String? // downscaled derivative used by the composition
  width       Int
  height      Int

  visionText          String? // JSON PageText
  ocrBoxes            String? // JSON OcrWord[]
  alignment           String? // JSON AlignedWord[]
  alignmentConfidence Float?

  /// PDF pages only. The number printed on the page ("xii", "37"), when the
  /// PDF records one — distinct from `pageIndex`, the position in the file.
  pageLabel     String?
  /// text-layer | ocr | vision | none — where this page's words came from.
  textSource    String?
  /// Mean Tesseract word confidence (0-100), for OCR'd pages only.
  ocrConfidence Float?

  @@index([uploadId])
  @@unique([uploadId, pageIndex])
}

/// A chapter or section of a PDF, detected from its outline, its headings, or
/// (failing both) a fixed page run. `skip` marks front and back matter —
/// contents, copyright, index — which is never mined for ideas.
model Section {
  id        String  @id @default(cuid())
  uploadId  String
  upload    Upload  @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  index     Int
  title     String
  level     Int     @default(1)
  startPage Int
  endPage   Int
  /// toc | heading | fallback
  source    String
  skip      Boolean @default(false)
  wordCount Int     @default(0)

  @@unique([uploadId, index])
}

/// A ~200-word passage of a PDF, the unit of embedding and retrieval.
/// `spans` ties every word back to a page and a word index on that page —
/// the same (sourcePage, startWord, endWord) coordinates a script beat cites.
model Chunk {
  id           String @id @default(cuid())
  uploadId     String
  upload       Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  index        Int
  sectionIndex Int
  startPage    Int
  endPage      Int
  spans        String // JSON SourceRef[]
  text         String
  wordCount    Int
  /// Float32 little-endian, L2-normalised. Null if embedding was unavailable.
  embedding    Bytes?

  @@unique([uploadId, index])
}

/// One video-worthy idea found in a PDF. Every idea is grounded: `sourceRefs`
/// point at the exact words on the exact pages it came from, and an idea whose
/// quotes could not be found in the book is never written here at all.
model ContentIdea {
  id              String  @id @default(cuid())
  uploadId        String
  upload          Upload  @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  bookId          String
  book            Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  rank            Int
  ideaKey         String
  title           String
  coreIdea        String
  hook            String
  whyItMatters    String
  angle           String
  hookPotential   String
  storyPotential  String
  practicalValue  String
  visualPotential String
  sectionTitle    String?
  sourcePages     String  // JSON number[] — page indices, ascending
  sourceRefs      String  // JSON SourceRef[]
  sourceText      String  // the cited words, verbatim from the page text
  relatedPages    String? // JSON number[] — other pages retrieved by similarity
  /// JSON IdeaScores. Internal: used to rank, never shown to the operator.
  scores          String
  score           Float
  /// PROPOSED | SELECTED
  status          String  @default("PROPOSED")
  episodes        Episode[]
  createdAt       DateTime @default(now())

  @@unique([uploadId, ideaKey])
  @@index([bookId])
}

/// One video.
model Episode {
  id       String  @id @default(cuid())
  bookId   String
  book     Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  uploadId String
  upload   Upload  @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  partNumber  Int    @default(1)
  seriesTotal Int    @default(1)
  theme       String @default("marginalia")
  ideaKey     String?

  /// photo | idea. A photo episode covers a page range of a photographed
  /// upload; an idea episode is made from one ContentIdea of a book PDF.
  kind          String       @default("photo")
  /// The video's frame. Only "9:16" is rendered today.
  format        String       @default("9:16")
  contentIdeaId String?
  contentIdea   ContentIdea? @relation(fields: [contentIdeaId], references: [id], onDelete: SetNull)

  status String  @default("QUEUED")
  step   String  @default("Queued")
  error  String?
  notes  String? // JSON string[] of advisory findings

  title        String?
  hook         String?
  script       String? // JSON Beat[]
  voScript     String?
  description  String?
  hashtags     String? // JSON string[]
  cta          String?

  /// YouTube keyword tags — comma-separated SEO keywords, distinct from the
  /// `#hashtags` above and from any platform. JSON string[], null when the
  /// operator has never set them (no backfill; every reader treats absent as
  /// "none yet"). YouTube counts the comma-joined line against a ~500-character
  /// ceiling, enforced in `limits.ts`, not here.
  youtubeTags  String? // JSON string[]

  /// Instagram copy, written INDEPENDENTLY of the YouTube description rather
  /// than derived from it. Each is null until the operator (or a regenerate)
  /// fills it, and while all three are absent the Instagram caption falls back
  /// to the historical hook+description+hashtags composition (`instagramCaption`
  /// in `limits.ts`) so nothing regresses for an episode made before these
  /// existed. `igHashtags` is a JSON string[]; the other two are plain prose.
  igHook       String?
  igCaption    String?
  igHashtags   String? // JSON string[]

  /// When the operator last typed over each of the new copy fields by hand, or
  /// NULL if never — the same protection the three columns below give
  /// title/description/hashtags: Regenerate will not overwrite a hand-edit
  /// without a second, explicit confirmation. Separate nullable timestamps for
  /// the same reason the originals are (see the note on `titleEditedAt`): they
  /// answer both "may Regenerate overwrite this?" and "when did that happen?",
  /// and cost the same NULL on every existing row.
  youtubeTagsEditedAt DateTime?
  igHookEditedAt      DateTime?
  igCaptionEditedAt   DateTime?
  igHashtagsEditedAt  DateTime?

  /// The poster the operator chose for one platform specifically, when it
  /// differs from `thumbChoice`. YouTube favours a 16:9 cover and Instagram a
  /// 9:16 one, and the six-poster set has both aspects, so the choice can differ
  /// per platform. Null means "no platform-specific choice", and every reader
  /// falls back to `thumbChoice` and then to the first poster of the platform's
  /// preferred aspect — exactly how `thumbChoice` already degrades.
  thumbChoiceYouTube   String?
  thumbChoiceInstagram String?

  verification String? // JSON GroundingReport
  groundedness Int?
  revised      Boolean @default(false)

  visualPlan  String? // JSON: page, word ranges, sweep timings, cue placements
  /// JSON Scene[] — what was on screen when, and what in the book each scene
  /// was grounded in (see lib/video/scenes). Null for an episode rendered
  /// before scenes existed, which is not invalid, only plainer.
  scenePlan   String?
  captions    String? // JSON CaptionLine[]
  srt         String?
  /// JSON {source, model, perBeat, words[{w,s,e,b,i,src}]} — when each script
  /// word was spoken, from the recorded voice (see media/narration-timing.ts).
  wordTimings  String?
  /// audio | mixed | estimated — whether subtitles and highlights follow the
  /// recorded voice, or fell back to an estimate. Null on older episodes.
  timingSource String?
  durationSec Float?
  audioPath   String?
  projectPath String?
  videoPath   String?
  /// JSON ThumbSpec[] — {key, aspect, variant, path, width, height}, written by
  /// `generateThumbnails`. Nullable, and never backfilled: an episode rendered
  /// before thumbnails existed is not invalid, it simply has none, and the
  /// delivery route treats absent and empty identically.
  thumbnails  String?
  /// The voice the narration actually used, resolved at render time. Null on
  /// rows written before the picker existed — the library says "not recorded"
  /// rather than guessing, because the setting may since have changed.
  voiceId       String?
  /// Which engine resolved it: pocket | elevenlabs | openai | system.
  voiceProvider String?
  /// The poster the operator chose for this episode. Null means "no choice
  /// made", and every reader falls back to the first 9:16 poster.
  thumbChoice   String?
  /// The headline the operator typed to replace the generated one, already
  /// drawn onto all six posters, and shown back in the retitle field. Null
  /// means the generated headline. Only the poster-edit route reads or writes
  /// it: the pipeline never does, so a full re-render of an episode redraws its
  /// posters from the script and this edit does not survive it.
  thumbHeadline String?

  /// When the operator last typed over this field by hand, or NULL if they
  /// never have — in which case what is stored is still what the writer wrote.
  ///
  /// Three nullable timestamps rather than three booleans, and rather than one
  /// JSON blob, because the Publish Center has to answer two questions and a
  /// boolean only answers the first: "may Regenerate overwrite this without
  /// asking?" and "when did that edit happen?". A `DateTime?` answers both and
  /// costs the same NULL on all 160 existing rows, so nothing needs a backfill
  /// and every reader that does not know about them is unaffected.
  ///
  /// They live on Episode, beside the columns they describe, NOT on PublishJob:
  /// the metadata is a property of the episode (one title, one description, one
  /// hashtag list — shared by every platform), while a PublishJob is a property
  /// of the episode-platform pair. Putting the edit marks on the job would make
  /// "has the title been hand-edited?" a question with a different answer per
  /// platform, which is not a thing that can be true.
  titleEditedAt       DateTime?
  descriptionEditedAt DateTime?
  hashtagsEditedAt    DateTime?

  startedAt  DateTime?
  finishedAt DateTime?
  totalMs    Int?
  steps      StepRun[]
  publishJobs PublishJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookId])
  @@index([uploadId])
  @@index([userId])
  @@index([contentIdeaId])
}

/// Where ONE episode stands on ONE platform. Nothing else in the app records
/// that, so before this table the answer to "did this go out?" lived only in
/// the operator's memory.
///
/// WHY A TABLE AND NOT COLUMNS ON EPISODE. The relationship is one-to-many by
/// nature: an episode goes to YouTube and to Instagram, and later to whatever
/// else. As columns that is `youtubeStatus`, `youtubeVideoId`, `youtubeError`,
/// `youtubePublishedAt`, `instagramStatus`, … — five more columns per platform,
/// a migration every time one is added, and a `SELECT` that cannot answer
/// "which episodes are waiting on anything" without naming every platform in
/// the query. A row per pair answers it with one `where`.
///
/// WHY ONE ROW PER PAIR AND NOT ONE PER ATTEMPT. This is current state, not an
/// audit log. `attempts` counts the tries and `lastError` holds the last
/// failure, which is what an operator looking at a card wants; an unbounded
/// history would grow on every retry and nothing would ever read the old rows.
/// `@@unique([episodeId, platform])` is what makes "the state" singular, and it
/// is what lets a recorder upsert instead of racing a read against a write.
///
/// `status` is the vocabulary in `src/lib/publish/limits.ts`:
/// NOT_READY | READY | REQUIRES_CONNECTION | PREPARING | UPLOADING | PUBLISHED
/// | FAILED. Only a platform's own confirmation may write PUBLISHED, and the
/// only way to get there in code is `PublishOutcome`'s PUBLISHED variant, which
/// cannot be constructed without an `externalId` the platform returned. There
/// is no publisher in this build that can produce one, so no row in this table
/// can honestly say PUBLISHED yet — and none does.
///
/// BACKWARD COMPATIBILITY. A new table with no rows. Every existing query and
/// all 160 existing episodes are untouched; absent rows are the correct reading
/// of "never published anywhere", which is the truth for all of them.
model PublishJob {
  id        String  @id @default(cuid())
  episodeId String
  episode   Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  /// youtube | instagram | manual. A free string, not an enum, because SQLite
  /// has no enums and a platform added later must not need a migration.
  platform  String

  status String @default("REQUIRES_CONNECTION")

  /// The id the PLATFORM gave this upload, and the URL it can be watched at.
  /// Both NULL until a platform confirms a publish. Never a locally invented
  /// id: an id that did not come from the platform cannot be used to check on,
  /// edit or delete what was posted, so it would be worse than no id at all.
  externalId  String?
  externalUrl String?

  /// JSON PublishedMetadata — the title, description and hashtags ACTUALLY
  /// handed over, frozen at the moment of the attempt. The episode's own
  /// columns keep changing (the operator edits them, Regenerate rewrites them),
  /// so without this snapshot there is no way to know what is live on a
  /// platform versus what is merely current here.
  metadata String?

  /// How many attempts have been made, and what the last one said when it
  /// failed. `lastError` is cleared by a success, so a stale message can never
  /// sit beside a good outcome.
  attempts  Int     @default(0)
  lastError String?

  /// `preparedAt` is when the metadata was last validated and handed over (for
  /// the assisted handoff, when the operator was given the files and text).
  /// `publishedAt` is ONLY ever set from a platform confirmation, alongside
  /// `externalId`.
  preparedAt  DateTime?
  publishedAt DateTime?

  /// THE PROGRESS IS MEASURED, NOT ESTIMATED. `uploadedBytes` is what the
  /// platform has acknowledged receiving (YouTube's resumable protocol answers
  /// every chunk with the byte range it now holds) and `totalBytes` is the size
  /// of the file on disk. A reader divides one by the other; nothing in this app
  /// invents a percentage, and a row with `totalBytes` null shows no bar at all
  /// rather than a plausible-looking one.
  uploadedBytes Int?
  totalBytes    Int?

  /// The resumable upload session, encrypted: it is a capability URL — anyone
  /// holding it can continue this upload into the operator's channel without a
  /// token. It is kept so a RETRY RESUMES instead of re-uploading 38 MB, and is
  /// cleared the moment the upload completes or the session is known to be dead.
  sessionUrlEnc String?

  /// The thumbnail is a SEPARATE outcome from the video, because a channel that
  /// is not verified cannot set one and that must not fail an upload that
  /// succeeded. `APPLIED` | `SKIPPED` | `FAILED`, with the platform's own reason
  /// beside it. Null means no attempt has been made.
  thumbnailStatus String?
  thumbnailError  String?

  /// The privacy the video was created with. Always `private` for an upload this
  /// app made: nothing here sets `public`, and recording what was sent means the
  /// operator can see it rather than take it on trust.
  privacyStatus String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([episodeId, platform])
  @@index([episodeId])
}

model StepRun {
  id         String   @id @default(cuid())
  episodeId  String
  episode    Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  step       String
  position   Int
  status     String   @default("RUNNING") // RUNNING | DONE | FAILED
  startedAt  DateTime
  endedAt    DateTime?
  durationMs Int?

  @@index([episodeId])
}

model UsedHook {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  hook      String
  hash      String   @unique
  createdAt DateTime @default(now())

  @@index([bookId])
}

/// The "one video, one idea" guarantee, enforceable rather than aspirational.
model UsedIdea {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  ideaKey   String
  episodeId String?
  createdAt DateTime @default(now())

  @@unique([bookId, ideaKey])
  @@index([bookId])
}

/// Project Gutenberg's whole catalogue, downloaded once and queried locally.
///
/// This model exists because searching `gutendex.com` took 34 seconds for the
/// operator's query and 42 for the next one — slow enough that the Free Books
/// page could not be used at all. The archive publishes the same data as one
/// 21MB CSV; it is imported here and search becomes a local `SELECT` with no
/// network call and therefore no timeout.
///
/// `generation` is what makes a failed sync harmless. A sync writes a whole new
/// generation alongside the live one and flips a single `Setting` at the end,
/// so a run that dies halfway leaves the previous catalogue serving unchanged
/// rather than leaving a half-populated table indistinguishable from a complete
/// one. `src/lib/gutenberg/catalog.ts` reads and writes this table with raw SQL
/// — a multi-row INSERT is what makes 76,000 rows a half-minute job.
model CatalogBook {
  /// The sync that wrote this row. Exactly one generation is ever live.
  generation  String
  /// Project Gutenberg's own id — the `Text#` column, and the id every
  /// download and text fetch is keyed by.
  gutenbergId Int
  /// Text | Sound | Image | Dataset | … Only `Text` is searchable here.
  type        String
  title       String
  /// Raw from the feed: "Shelley, Mary Wollstonecraft, 1797-1851; …".
  authors     String
  /// Semicolon-separated Library of Congress subject headings.
  subjects    String
  language    String
  /// ISO date the archive first issued it, as a string — the feed's own form.
  issued      String
  /// Always `public-domain`: the feed has no rights column and everything the
  /// archive distributes is public domain in the US. Stored rather than assumed
  /// so the quotation budget reads a value instead of a hardcoded belief.
  rights      String

  @@id([generation, gutenbergId])
  @@index([generation, type])
}
